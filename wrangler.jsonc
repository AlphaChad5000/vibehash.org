// The site on Cloudflare Workers: dist/ (the React build, plus public/: the guide, /network/, the installers, the
// whitepaper) served as static assets, and worker/index.ts in front of /api/* only. Deploy: `npm run deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibehash-web",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /wallet, /jobs/<id>, /submit: anything that isn't a file gets the app's index.html (with a 200), and the
    // router takes it from there. Real files and folders (/guide/, /network/, /install.sh) are served as they are.
    "not_found_handling": "single-page-application",
    // The Worker runs only for the node's API; every other request is a plain asset, which is free and fastest.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "NODE": "https://node.vibehash.org"
  },
  "observability": { "enabled": true },
  // Keep the workers.dev address and per-version preview URLs alongside the real domain.
  "workers_dev": true,
  "preview_urls": true,
  // vibehash.org and www, as custom domains: Cloudflare keeps their DNS records and certificates. node.vibehash.org
  // is a separate record (the testnet node) and isn't touched. The workers.dev address keeps working as a preview.
  "routes": [
    { "pattern": "vibehash.org", "custom_domain": true },
    { "pattern": "www.vibehash.org", "custom_domain": true }
  ]
}
